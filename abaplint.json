      "exclude": [],
      "severity": "Error",
      "numericParameters": true
    },
    "names_no_dash": {
      "exclude": [],
      "severity": "Error"
    },
    "nesting": {
      "exclude": [],
      "severity": "Warning",
      "depth": 5
