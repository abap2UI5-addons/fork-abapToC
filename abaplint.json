      "severity": "Error"
    },
    "check_syntax": {
      "exclude": [],
      "severity": "Error"
    },
    "check_transformation_exists": {
      "exclude": [],
      "severity": "Warning"
    },
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": {
      "exclude": [],
