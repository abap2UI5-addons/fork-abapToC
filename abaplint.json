    "contains_tab": true,
    "cyclic_oo": {
      "exclude": [],
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    "cyclomatic_complexity": {
      "exclude": [],
      "max": 10,
      "severity": "Error"
    },
    "dangerous_statement": {
      "exclude": [],
      "severity": "Warning",
      "execSQL": true,
      "kernelCall": true,
      "systemCall": true,
      "insertReport": true,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "deleteDynpro": true,
      "exportDynpro": true,
      "dynamicSQL": true
    },
    "db_operation_in_loop": true,
    "description_empty": true,
    "downport": true,
    "dynpro_checks": {
      "exclude": [],
      "severity": "Error"
    },
    "easy_to_find_messages": true,
    "else_after_all_returns": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "at": true,
      "case": true,
      "catch": true,
      "do": true,
      "exclude": [],
      "if": true,
      "loop": false,
      "select": true,
      "try": true,
      "when": false,
      "while": true
    },
    "exit_or_check": {
      "exclude": [],
      "severity": "Error",
      "allowExit": false,
      "allowCheck": false
